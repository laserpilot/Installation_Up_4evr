<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Up 4evr keep-alive LaunchAgent.
  Generated by install-keepalive.command. ProgramArguments is filled in by the
  installer (left empty here on purpose):
    * .app bundles  -> ["/usr/bin/open", "-W", "<App>.app"]
      `open -W` launches the app THROUGH LaunchServices (required on modern
      macOS — exec'ing the binary directly fails code-signing) and blocks
      until it exits, so KeepAlive relaunches it on crash/quit.
    * plain executables -> ["<path/to/binary>"] run directly.
  launchd also relaunches at login (RunAtLoad).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <key>ProgramArguments</key>
    <array/>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>__LOG__</string>
    <key>StandardErrorPath</key>
    <string>__LOG__</string>
</dict>
</plist>
